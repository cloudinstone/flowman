{
  "manifest_version": 3,
  "name": "Flowman - Google Flow Batch Downloader",
  "version": "0.3.0",
  "description": "Batch-download videos (720p / 1080p / 4K) and images (1K / 2K / 4K) from Google Flow serially in the background.",
  "permissions": ["downloads", "sidePanel"],
  "host_permissions": ["https://flow.google.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Open Flowman"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://flow.google.com/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://flow.google.com/*"],
      "js": ["src/page-bridge.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
